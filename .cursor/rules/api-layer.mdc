description: All data/DB access goes through the API layer; server code uses lib/api, not lib/services
globs: ["**/app/**/*.ts", "**/app/**/*.tsx", "**/lib/api/**/*.ts", "**/lib/services/**/*.ts"]
alwaysApply: false
