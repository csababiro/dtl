# Backend API base URL (no trailing slash). If unset, the app uses same-origin /api (built-in quote-requests).
# Development with external API: http://localhost:3001
# Production: https://api.yourdomain.com
# NEXT_PUBLIC_API_URL=http://localhost:3001

# Set to true to access admin routes without backend (local development)
# NEXT_PUBLIC_MOCK_AUTH=true

# Mock admin role for Feature Flags page: only that role's column is shown.
# super_admin = see and edit only Super Admin toggles; admin = only Admin toggles.
# Unset or any other value = Super Admin view.
# NEXT_PUBLIC_MOCK_ADMIN_ROLE=super_admin
# NEXT_PUBLIC_MOCK_ADMIN_ROLE=admin

# Mock current user for Utilizatori (admin users) management. User id from dummy data (e.g. u1, u2).
# If unset, the first Super Admin is treated as current user (can create/edit/delete users).
# Set to an Admin id (e.g. u2) to test "can manage users" flag; set to Staff id (e.g. u4) to see read-only list.
# NEXT_PUBLIC_MOCK_USER_ID=u1

# Optional: Google Maps API key for harta interactivă (Maps Embed API). Enable "Maps Embed API" in Google Cloud Console.
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Firebase Cloud Messaging (push notifications). From Firebase Console > Project settings > General (Web app) and Cloud Messaging.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=   # Cloud Messaging > Web Push certificates (Key pair)
# FIREBASE_SERVICE_ACCOUNT_JSON=    # JSON string of service account key (Project settings > Service accounts)
