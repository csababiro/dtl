# Backend API base URL (no trailing slash)
# Development: http://localhost:3001
# Production: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional: when backend is unavailable, set to true so staff can access admin routes for local development.
# Remove or ignore once real backend and session exist.
# NEXT_PUBLIC_MOCK_AUTH=true

# Optional: for embedded Google Map on Contact and Home (when set, Map component can show real map).
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=your_key
