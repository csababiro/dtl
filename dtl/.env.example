# Backend API base URL (no trailing slash). If unset, the app uses same-origin /api (built-in quote-requests).
# Development with external API: http://localhost:3001
# Production: https://api.yourdomain.com
# NEXT_PUBLIC_API_URL=http://localhost:3001

# Set to true to access admin routes without backend (local development)
# NEXT_PUBLIC_MOCK_AUTH=true

# Mock admin role for Feature Flags page: only that role's column is shown.
# super_admin = see and edit only Super Admin toggles; admin = only Admin toggles.
# Unset or any other value = Super Admin view.
# NEXT_PUBLIC_MOCK_ADMIN_ROLE=super_admin
# NEXT_PUBLIC_MOCK_ADMIN_ROLE=admin

# Optional: Google Maps API key for map embed
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=
